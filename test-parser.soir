leq :: Int -> Int -> Bool ;;
leq a b = __builtin_leq a b ;;

other_var = "world" ;;

infix 48 <~> leq ;;
unaryl  12 - __builtin_negate ;;

main = let var = other_var in
	 match x in
		| Just x -> (match -3 <~> 4 in
			| True -> "woah"
			| False -> "hi")
		| Nothing -> var
;;

Option.unwrap_or x y =
	match x in
		| Just x2 -> x2
		| Nothing -> (\yy -> yy) y
;;

example v = V.field v
;;
